{
  "_comment": [
    "Shared block definitions. A block is a named list of fields that more than",
    "one form needs. Referenced from a schema as { \"type\": \"block\", \"block\": \"person-name\" }.",
    "",
    "Fields marked includeIf/excludeIf appear only when the reference passes that",
    "option, which is how one name block covers a head of household (no maiden",
    "name) and a spouse (maiden name) without duplicating either.",
    "",
    "Labels may interpolate options with {{doubleBraces}}."
  ],

  "person-name": {
    "defaults": { "middleName": true, "nickname": true, "suffix": true, "maidenName": false },
    "fields": [
      {
        "id": "first",
        "type": "text",
        "label": "First name",
        "required": true,
        "width": "half",
        "autocomplete": "given-name"
      },
      {
        "id": "middle",
        "type": "text",
        "label": "Middle name",
        "width": "half",
        "includeIf": "middleName",
        "autocomplete": "additional-name"
      },
      {
        "id": "last",
        "type": "text",
        "label": "Last name",
        "required": true,
        "width": "half",
        "autocomplete": "family-name"
      },
      {
        "id": "maiden",
        "type": "text",
        "label": "Maiden name",
        "width": "half",
        "includeIf": "maidenName",
        "help": "If it differs from the last name above."
      },
      {
        "id": "nickname",
        "type": "text",
        "label": "Nickname",
        "width": "half",
        "includeIf": "nickname",
        "help": "What we should call you in person."
      },
      {
        "id": "suffix",
        "type": "text",
        "label": "Suffix",
        "width": "half",
        "includeIf": "suffix",
        "placeholder": "Jr., Sr., II",
        "maxLength": 12
      }
    ]
  },

  "address": {
    "defaults": { "sameAs": false, "sameAsLabel": "the address above" },
    "fields": [
      {
        "id": "sameAs",
        "type": "checkbox",
        "label": "Same as {{sameAsLabel}}",
        "width": "full",
        "includeIf": "sameAs",
        "default": true
      },
      {
        "id": "street",
        "type": "text",
        "label": "Street or PO Box",
        "required": true,
        "width": "full",
        "autocomplete": "street-address",
        "showIf": { "field": "sameAs", "notEquals": true }
      },
      {
        "id": "city",
        "type": "text",
        "label": "City",
        "required": true,
        "width": "half",
        "autocomplete": "address-level2",
        "showIf": { "field": "sameAs", "notEquals": true }
      },
      {
        "id": "state",
        "type": "state",
        "label": "State",
        "required": true,
        "width": "half",
        "placeholder": "Choose a state…",
        "showIf": { "field": "sameAs", "notEquals": true }
      },
      {
        "id": "zip",
        "type": "zip",
        "label": "ZIP code",
        "required": true,
        "width": "half",
        "autocomplete": "postal-code",
        "placeholder": "98922",
        "showIf": { "field": "sameAs", "notEquals": true }
      }
    ]
  },

  "contact": {
    "defaults": { "emailRequired": false },
    "fields": [
      {
        "id": "email",
        "type": "email",
        "label": "Email address",
        "width": "full",
        "autocomplete": "email",
        "placeholder": "you@example.com",
        "help": "This is how the parish office reaches you for most things."
      },
      {
        "id": "homePhone",
        "type": "tel",
        "label": "Home phone",
        "width": "half",
        "autocomplete": "tel"
      },
      {
        "id": "mobilePhone",
        "type": "tel",
        "label": "Mobile phone",
        "width": "half",
        "autocomplete": "tel"
      }
    ]
  },

  "sacrament-record": {
    "_comment": [
      "Nothing past the first question is asked unless the answer is yes.",
      "Parish, city and country sit together because they are one thought: where",
      "the record is held. The celebrant comes last, being the part people are",
      "least likely to remember.",
      "`askTradition` turns on which tradition the sacrament was received in.",
      "Turn it on for baptism. A baptism in another Trinitarian church is",
      "recognised and is never repeated, so the answer decides whether the office",
      "is tracing an existing record or preparing a sacrament."
    ],
    "defaults": { "rite": "this sacrament", "askTradition": false },
    "fields": [
      {
        "id": "received",
        "type": "radio",
        "label": "Has {{rite}} been received?",
        "required": true,
        "width": "full",
        "options": [
          { "value": "yes", "label": "Yes" },
          { "value": "no", "label": "No" },
          { "value": "unsure", "label": "Not sure" }
        ]
      },
      {
        "id": "tradition",
        "type": "radio",
        "includeIf": "askTradition",
        "label": "In what tradition?",
        "required": true,
        "width": "full",
        "help": "A baptism in another Trinitarian church is recognised and is never repeated. Knowing this tells the office whether to trace the record.",
        "options": [
          { "value": "catholic", "label": "Catholic" },
          { "value": "other", "label": "Another Christian tradition" },
          { "value": "unsure", "label": "Not sure" }
        ],
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "traditionName",
        "type": "text",
        "includeIf": "askTradition",
        "label": "Which church or denomination?",
        "width": "full",
        "placeholder": "Lutheran, Methodist, Anglican, Orthodox…",
        "showIf": {
          "all": [
            { "field": "received", "equals": "yes" },
            { "field": "tradition", "equals": "other" }
          ]
        }
      },
      {
        "id": "date",
        "type": "date",
        "label": "Date of {{rite}}",
        "width": "full",
        "isBirthdate": false,
        "approximate": true,
        "help": "A year on its own is fine if that is all you remember.",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "parish",
        "type": "text",
        "label": "Parish or church name",
        "width": "half",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "cityState",
        "type": "text",
        "label": "City and state or province",
        "width": "half",
        "placeholder": "Roslyn, WA",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "country",
        "type": "text",
        "label": "Country",
        "width": "half",
        "default": "United States",
        "help": "Change this if it took place in another country.",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "celebrant",
        "type": "text",
        "label": "Celebrant's name",
        "width": "half",
        "help": "The priest or deacon. Leave it blank if you do not know.",
        "showIf": { "field": "received", "equals": "yes" }
      }
    ]
  },

  "marriage-record": {
    "_comment": "Marriage carries a location that is often not a parish, so it gets its own block.",
    "fields": [
      {
        "id": "received",
        "type": "radio",
        "label": "Has marriage been received?",
        "required": true,
        "width": "full",
        "options": [
          { "value": "yes", "label": "Yes" },
          { "value": "no", "label": "No" },
          { "value": "unsure", "label": "Not sure" }
        ]
      },
      {
        "id": "date",
        "type": "date",
        "label": "Date of marriage",
        "width": "full",
        "approximate": true,
        "help": "A year on its own is fine if that is all you remember.",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "parish",
        "type": "text",
        "label": "Parish married at",
        "width": "half",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "location",
        "type": "text",
        "label": "Place or location married at",
        "width": "half",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "cityState",
        "type": "text",
        "label": "City and state or province",
        "width": "half",
        "placeholder": "Roslyn, WA",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "country",
        "type": "text",
        "label": "Country",
        "width": "half",
        "default": "United States",
        "help": "Change this if it took place in another country.",
        "showIf": { "field": "received", "equals": "yes" }
      }
    ]
  },

  "ocia-sacrament": {
    "_comment": [
      "OCIA needs to know the tradition a sacrament was received in, because that",
      "decides whether it is recognised and therefore what the person still needs.",
      "The parish and date are optional but genuinely useful, since a baptism has",
      "to be traced before it can be accepted."
    ],
    "defaults": { "rite": "this sacrament" },
    "fields": [
      {
        "id": "received",
        "type": "radio",
        "label": "Have you received {{rite}}?",
        "required": true,
        "width": "full",
        "options": [
          { "value": "yes", "label": "Yes" },
          { "value": "no", "label": "No" },
          { "value": "unsure", "label": "Not sure" }
        ]
      },
      {
        "id": "tradition",
        "type": "radio",
        "label": "In what tradition?",
        "required": true,
        "width": "full",
        "options": [
          { "value": "catholic", "label": "Catholic" },
          { "value": "other", "label": "Another Christian tradition" },
          { "value": "unsure", "label": "Not sure" }
        ],
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "traditionName",
        "type": "text",
        "label": "Which church or denomination?",
        "width": "full",
        "placeholder": "Lutheran, Methodist, Anglican, Orthodox…",
        "showIf": {
          "all": [
            { "field": "received", "equals": "yes" },
            { "field": "tradition", "equals": "other" }
          ]
        }
      },
      {
        "id": "date",
        "type": "date",
        "label": "Date of {{rite}}",
        "width": "full",
        "approximate": true,
        "help": "Give the exact date if you have it. A year on its own is fine if that is all you remember.",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "church",
        "type": "text",
        "label": "Church or parish",
        "width": "half",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "cityState",
        "type": "text",
        "label": "City and state or province",
        "width": "half",
        "placeholder": "Roslyn, WA",
        "showIf": { "field": "received", "equals": "yes" }
      },
      {
        "id": "country",
        "type": "text",
        "label": "Country",
        "width": "half",
        "default": "United States",
        "help": "Change this if it took place in another country.",
        "showIf": { "field": "received", "equals": "yes" }
      }
    ]
  },

  "adult": {
    "_comment": "A named person plus the two facts every parish record needs about them.",
    "fields": [
      {
        "type": "block",
        "block": "person-name",
        "id": null
      },
      {
        "id": "birthdate",
        "type": "date",
        "label": "Date of birth",
        "required": true,
        "width": "full",
        "isBirthdate": true
      },
      {
        "id": "birthplace",
        "type": "text",
        "label": "Place of birth",
        "width": "half",
        "placeholder": "City and state"
      }
    ]
  },

  "adult-sacraments": {
    "fields": [
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "baptism",
        "label": "Baptism",
        "options": { "rite": "baptism", "askTradition": true }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "eucharist",
        "label": "First Eucharist",
        "options": { "rite": "first Eucharist" }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "confirmation",
        "label": "Confirmation",
        "options": { "rite": "confirmation" }
      },
      {
        "type": "block",
        "block": "marriage-record",
        "id": "marriage",
        "label": "Marriage"
      }
    ]
  },

  "child": {
    "_comment": "The paper form gives four fixed child slots. This repeats without a limit.",
    "fields": [
      {
        "type": "block",
        "block": "person-name",
        "id": null,
        "options": { "nickname": true, "suffix": true, "maidenName": false }
      },
      {
        "id": "birthdate",
        "type": "date",
        "label": "Date of birth",
        "required": true,
        "width": "full",
        "isBirthdate": true
      },
      {
        "id": "birthplace",
        "type": "text",
        "label": "Place of birth",
        "width": "half",
        "placeholder": "City and state"
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "baptism",
        "label": "Baptism",
        "options": { "rite": "baptism", "askTradition": true }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "eucharist",
        "label": "First Eucharist",
        "options": { "rite": "first Eucharist" }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "confirmation",
        "label": "Confirmation",
        "options": { "rite": "confirmation" }
      }
    ]
  },

  "ff-child": {
    "_comment": [
      "Faith formation is one paper form per child. Online it repeats inside a",
      "single household submission, so a parent enters their own details once",
      "no matter how many children they enroll. Tuition is billed per family,",
      "which the paper tuition table already assumes."
    ],
    "fields": [
      {
        "type": "block",
        "block": "person-name",
        "id": null,
        "options": { "middleName": true, "nickname": true, "suffix": false, "maidenName": false }
      },
      {
        "id": "birthdate",
        "type": "date",
        "label": "Date of birth",
        "required": true,
        "width": "full",
        "isBirthdate": true
      },
      {
        "id": "birthplace",
        "type": "text",
        "label": "Place of birth",
        "width": "half",
        "placeholder": "City and state"
      },
      {
        "id": "grade",
        "type": "select",
        "label": "Grade level for the current school year",
        "required": true,
        "width": "half",
        "placeholder": "Choose a grade…",
        "options": [
          { "value": "PK", "label": "Preschool" },
          { "value": "K", "label": "Kindergarten" },
          { "value": "1", "label": "1st grade" },
          { "value": "2", "label": "2nd grade" },
          { "value": "3", "label": "3rd grade" },
          { "value": "4", "label": "4th grade" },
          { "value": "5", "label": "5th grade" },
          { "value": "6", "label": "6th grade" },
          { "value": "7", "label": "7th grade" },
          { "value": "8", "label": "8th grade" },
          { "value": "9", "label": "9th grade" },
          { "value": "10", "label": "10th grade" },
          { "value": "11", "label": "11th grade" },
          { "value": "12", "label": "12th grade" }
        ]
      },
      {
        "id": "school",
        "type": "text",
        "label": "School currently attending",
        "width": "full"
      },
      {
        "type": "static",
        "id": "baptismCertificateNotice",
        "html": "<p>Please send a copy of your child's baptismal certificate if the child was not baptized at Immaculate Conception, Roslyn or St. John the Baptist, Cle Elum. You can bring it to the parish office or email it to <a href=\"mailto:parish@ukccatholic.org\">parish@ukccatholic.org</a>.</p>"
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "baptism",
        "label": "Baptism",
        "options": { "rite": "baptism", "askTradition": true }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "eucharist",
        "label": "First Holy Communion",
        "options": { "rite": "first Holy Communion" }
      },
      {
        "type": "block",
        "block": "sacrament-record",
        "id": "confirmation",
        "label": "Confirmation",
        "options": { "rite": "confirmation" }
      },
      {
        "id": "medical",
        "type": "textarea",
        "label": "Learning concerns, medical conditions, or allergies",
        "width": "full",
        "rows": 4,
        "maxLength": 2000,
        "help": "Anything a catechist should know. Leave it blank if there is nothing."
      }
    ]
  },

  "parent": {
    "_comment": "Father, mother, and custodial guardian are the same shape on the paper form.",
    "defaults": { "maidenName": false },
    "fields": [
      {
        "type": "block",
        "block": "person-name",
        "id": null,
        "options": { "middleName": false, "nickname": false, "suffix": false }
      },
      {
        "id": "religion",
        "type": "text",
        "label": "Religion",
        "width": "half"
      },
      {
        "type": "block",
        "block": "address",
        "id": "address",
        "label": "Address",
        "options": { "sameAs": true, "sameAsLabel": "the child's address" }
      },
      {
        "type": "block",
        "block": "contact",
        "id": "contact"
      }
    ]
  },

  "emergency-contact": {
    "_comment": "Used when the parish cannot reach a parent. Release rules are on the schema.",
    "fields": [
      {
        "id": "name",
        "type": "text",
        "label": "Name",
        "required": true,
        "width": "half",
        "autocomplete": "name"
      },
      {
        "id": "relationship",
        "type": "text",
        "label": "Relationship to the child",
        "required": true,
        "width": "half",
        "placeholder": "Grandmother, neighbor, aunt"
      },
      {
        "id": "address",
        "type": "text",
        "label": "Address",
        "width": "full",
        "help": "Optional. A phone number matters more than a street address here."
      },
      {
        "type": "block",
        "block": "contact",
        "id": "contact"
      }
    ]
  },

  "consent-photo": {
    "_comment": [
      "The opt-out wording is reproduced from the paper faith formation form.",
      "Do not rewrite it. Changes are the pastor's call."
    ],
    "fields": [
      {
        "type": "static",
        "id": "photoNotice",
        "label": "Photo release",
        "html": "<p>Please check the box if you do not wish to have your child's photo used in any publications (Bulletin, Faith Formation Program, website photos).</p>"
      },
      {
        "id": "optOut",
        "type": "checkbox",
        "label": "Do not use my child's photo in parish publications.",
        "width": "full"
      }
    ]
  }
}
